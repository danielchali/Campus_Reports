# Campus Reports Backend Environment Example
# Copy this file to .env and replace placeholder values.

# Core runtime
NODE_ENV=production
PORT=5000
JWT_SECRET=replace_with_long_random_secret

# Database (either one works; MONGODB_URI is preferred)
MONGODB_URI=mongodb://localhost:27017/campusreports
MONGO_URI=

# Optional Upstash Redis cache. Leave blank to run without a shared cache.
# Configure these in the backend deployment environment, not in source control.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_CACHE_TTL_SECONDS=60
# Requests per IP per rolling window. Redis makes these limits shared across instances.
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# API and frontend integration
# Add every frontend URL that should be allowed to call this backend.
CORS_ORIGIN=http://localhost:3000,https://campusreports.vercel.app
FRONTEND_URL=https://campusreports.vercel.app
# Google Identity Services web client ID. It must match NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
# Optional comma-separated regular expressions for dynamic preview URLs.
# Example: ^https://campusreports(-[a-z0-9-]+)?\.vercel\.app$
CORS_ORIGIN_PATTERNS=

# Portal embed integration (iframe in student portal / LMS)
# Comma-separated origins allowed to embed /embed/report (also configurable in admin system settings).
PORTAL_EMBED_ORIGINS=http://localhost:3000,https://campusreports.vercel.app

# Login protection
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000
# Email verification codes are required for all management roles after password sign-in.
# Codes expire after 10 minutes by default (maximum 60).
TWO_FACTOR_CODE_TTL_MINUTES=10

# Startup behavior
CREATE_DEFAULT_USERS=false

# Anonymous report privacy
IP_SALT=replace_with_random_salt_value

# Optional email notifications. SMTP credentials are also required for management-role 2FA sign-in codes.
EMAIL_ENABLED=false
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-google-app-password
ADMIN_EMAIL=admin@example.com

# Real-time dashboards use Socket.IO on the same port as the API server.
# Frontend connects via NEXT_PUBLIC_SOCKET_URL (defaults to API host without /api path).

# AI assistant + NLP analytics (OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=Campus Reports

{
    "name": "campus-reports",
    "version": "1.0.0",
    "description": "Campus Reports",
    "scripts": {
        "install-all": "npm install && cd frontend && npm install && cd ../backend && npm install",
        "dev": "cd backend && npm run dev & cd frontend && npm run dev",
        "build": "cd frontend && npm run build",
        "deploy-pwa": "node scripts/deploy-pwa.js",
        "deploy-backend": "node scripts/deploy-pwa.js --backend",
        "fix-permissions": "node scripts/fix-permissions.js",
        "test-db": "node scripts/test-database.js",
        "test:backend": "npm --prefix backend test",
        "test:frontend": "npm --prefix frontend test",
        "test:backend:coverage": "npm --prefix backend run test:coverage",
        "test:frontend:coverage": "npm --prefix frontend run test:coverage",
        "test:coverage": "npm run test:backend:coverage && npm run test:frontend:coverage",
        "test": "npm run test:backend && npm run test:frontend"
    },
    "dependencies": {
        "chart.js": "^4.5.0",
        "clsx": "^2.1.1",
        "exceljs": "^4.4.0",
        "react-chartjs-2": "^5.3.0",
        "socket.io": "^4.8.1",
        "socket.io-client": "^4.8.1"
    },
    "devDependencies": {
        "@typescript-eslint/eslint-plugin": "^8.38.0",
        "@typescript-eslint/parser": "^8.38.0"
    }
}
